load("@rules_go//go:def.bzl", "go_binary", "go_library")

go_binary(
    name = "server",
    embed = [":server_lib"],
    importpath = "github.com/barbodimani81/task/cmd/server",
    # No cgo, so the binary is static and runs on distroless/static, which has no libc.
    pure = "on",
    visibility = ["//visibility:public"],
)

go_library(
    name = "server_lib",
    srcs = ["main.go"],
    importpath = "github.com/barbodimani81/task/cmd/server",
    visibility = ["//visibility:private"],
    deps = [
        "//internal/app",
        "//internal/greetings",
        "@com_github_jackc_pgx_v5//pgxpool",
    ],
)
