module(
    name = "task",
    version = "0.1.0",
)

bazel_dep(
    name = "rules_go",
    version = "0.65.0",
)

bazel_dep(
    name = "gazelle",
    version = "0.51.3",
)

# Use the locally installed Go SDK (dl.google.com/go is unreachable here).
go_sdk = use_extension(
    "@rules_go//go:extensions.bzl",
    "go_sdk",
)

go_sdk.host()

go_deps = use_extension(
    "@gazelle//:extensions.bzl",
    "go_deps",
)

go_deps.from_file(
    go_mod = "//:go.mod",
)
